# --- Database ---------------------------------------------------------
# Local Postgres connection string. See README for setup instructions.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/draftiq"

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fantasy season this deployment defaults to. The app is not hardcoded to
# a single year -- Season rows in the database drive what's selectable,
# this only sets the initial default.
NEXT_PUBLIC_DEFAULT_SEASON="2026"

# --- Auth (demo mode) ---------------------------------------------------
# Secret used to sign the local/demo session cookie. Generate with:
#   openssl rand -base64 32
DEMO_AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- AI (optional) -------------------------------------------------------
# Leave both unset to run the AI Assistant in deterministic fallback mode.
# Server-side only -- never exposed to the browser.
AI_PROVIDER="fallback"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL=""

# --- Live NFL data provider (optional) ------------------------------------
# Leave unset (or "seed") to read from the seeded/imported dataset only.
# "sleeper" pulls real, current player bios/rosters/status from Sleeper's
# free public API (api.sleeper.app) -- no key required. It does not cover
# ADP/rankings/projections (proprietary data); use CSV/JSON import at
# /import, or implement a paid-vendor NFLDataProvider, for those.
DATA_PROVIDER="seed"
